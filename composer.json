{
    "name": "jmrashed/logger",
    "description": "A lightweight, production-ready logging utility for development environments",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Md Rasheduzzzaman",
            "email": "jmrashed@gmail.com",
            "homepage": "https://github.com/jmrashed/logger"
        }
    ],
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3|^8.4",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "DevLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "lint": "phpstan analyse --memory-limit=512M",
        "check": [
            "@test",
            "@lint"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}